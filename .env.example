# Generate a key with at least 24 characters. This protects the local household instance.
NOMA_LOCAL_ACCESS_KEY=replace-with-a-random-key-at-least-24-characters
# Official cloud origin; no /api/v1 suffix. HTTPS is required.
NOMA_CLOUD_URL=https://noma-ai.cloud
# HA address as seen FROM the container, not the browser.
# For HA on the Docker host: http://host.docker.internal:8123
NOMA_HA_URL=http://homeassistant.local:8123
NOMA_HA_TOKEN=
# Explicit list of readable and controllable entities. Empty means no device access.
NOMA_HA_ALLOWED_ENTITIES=light.living_room,switch.desk
# Host binding: change to 0.0.0.0 only when LAN access is intended.
NOMA_LOCAL_BIND=127.0.0.1
NOMA_LOCAL_PORT=3000
# Native go run only; Compose sets the container listen address separately.
NOMA_LOCAL_ADDR=127.0.0.1:3000
# Native development: the reused Next.js UI runs on port 3001 behind the Go gateway.
NOMA_WEB_URL=http://127.0.0.1:3001
# Native frontend SSR only; Compose injects its internal gateway address.
NOMA_INTERNAL_API_URL=http://127.0.0.1:3000/api/v1
# Optional override; Noma's public Clerk key is built in, including when this is empty.
# Local origins and OAuth callbacks must be allowed by the Clerk/cloud instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsubm9tYS1haS5jbG91ZCQ
# Set true when served behind a LOCAL HTTPS reverse proxy (HttpOnly cookie becomes Secure).
NOMA_LOCAL_SECURE_COOKIE=false
